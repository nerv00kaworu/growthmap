# Required by the release launcher. Set an explicit URL for the intended authoring database.
# Never commit a production database path.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/growthmap.db

# Comma-separated exact editor browser origins. Keep this empty unless the editor
# is served from a different origin than its API.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100
