{
  "name": "growthmap-frontend",
  "version": "0.1.0-authoring.2",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "tsx --test src/**/*.test.ts && node --test src/lib/stable-module-ids.node-test.mjs",
    "build": "next build && node ../../desktop/scripts/generate-csp-manifest.js",
    "start": "next start --port 3100",
    "test:deterministic-build": "node ../../desktop/scripts/test-deterministic-frontend-build.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.6.0",
    "next": "15.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reactflow": "^11.11.4",
    "sharp": "0.35.3",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
