{
  "name": "growthmap-desktop",
  "version": "0.1.0-desktop.2",
  "private": true,
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "pack:dir": "npm run preflight && electron-builder --dir",
    "dist:win": "npm run preflight:win && electron-builder --win nsis --publish never --config electron-builder-unsigned.js",
    "dist:win:signed": "node scripts/require-signed-release.js && npm run preflight:win && electron-builder --win nsis --publish never --config electron-builder-signed.js",
    "dist:win:e2e": "npm run preflight:win && electron-builder --win dir --config scripts/e2e-builder-config.js --publish never",
    "dist:win:gift-staging": "node scripts/prepare-gift-staging-config.js && npm run preflight:win && electron-builder --win nsis --publish never --config electron-builder-staging.js",
    "dist:win:production-unsigned": "node scripts/prepare-production-unsigned-config.js && npm run preflight:win && electron-builder --win nsis --publish never --config electron-builder-production-unsigned.js",
    "preflight": "node scripts/preflight.js",
    "preflight:win": "node scripts/preflight.js win32",
    "csp:generate": "node scripts/generate-csp-manifest.js",
    "renderer:e2e": "node scripts/renderer-e2e.js"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "glob": "11.1.0",
    "ejs": "3.1.10",
    "filelist": "2.0.2",
    "rimraf": "6.1.2",
    "js-yaml": "4.3.1",
    "fast-uri": "4.1.2"
  },
  "devDependencies": {
    "@electron/asar": "4.0.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "playwright-core": "1.62.0"
  },
  "build": {
    "appId": "com.growthmap.desktop",
    "productName": "GrowthMap",
    "artifactName": "GrowthMap-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "agent-access.js",
      "agent-access-ipc.js",
      "preload.js",
      "secret-store.js",
      "secure-files.js",
      "credential-startup.js",
      "credential-ipc.js",
      "credential-lineage.js",
      "credential-lineage-async.js",
      "authority-schema.js",
      "credential-hydration-orchestrator.js",
      "production-launch.js",
      "pending-replacement-launch.js",
      "replacement-journal.js",
      "replacement-journal-async.js",
      "replacement-recovery.js",
      "safe-open-evidence.js",
      "safe-evidence-opener.js",
      "windows-native-broker.js",
      "windows-native-broker-helper.ps1",
      "windows-production-wiring.js",
      "windows-native-evidence.js",
      "windows-native-evidence-helper.ps1",
      "windows-native-replacement.js",
      "windows-native-replacement-helper.ps1",
      "sidecar-hydration-capability.js",
      "lifecycle.js",
      "database-manager.js",
      "database-workspace.js",
      "sidecar-error.js",
      "sidecar-readiness.js",
      "sidecar-port-reservation.js",
      "activation-relaunch.js",
      "request-policy.js",
      "update-policy.js",
      "purchase-portal.js",
      "activation-client.js",
      "activation-refresh.js",
      "activation-provenance-store.js",
      "license-refresh-policy.js",
      "license-refresh-orchestrator.js",
      "updater.js",
      "update-recovery.js",
      "managed-backup.js",
      "trial-store.js",
      "revocation-store.js",
      "license-freshness-store.js",
      "protected-history.js",
      "strict-json.js",
      "startup-policy.js",
      "startup-verdict.js",
      "commercial-config.js",
      "release-mode.js",
      "release-mode.json",
      "license-file.js",
      "device-identity-store.js",
      "product-identity.json",
      "commercial-config.json",
      "!e2e-main.js",
      "package.json",
      "csp.js",
      "generated/csp-script-hashes.json"
    ],
    "extraResources": [
      {
        "from": "../src/frontend/out",
        "to": "frontend"
      },
      {
        "from": "commercial-config.json",
        "to": "commercial-config.json"
      },
      {
        "from": "../src/backend/desktop/license_public_key.pem",
        "to": "commercial/license_public_key.pem"
      },
      {
        "from": "../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../EULA.md",
        "to": "legal/EULA.md"
      },
      {
        "from": "../PRIVACY.md",
        "to": "legal/PRIVACY.md"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "月影塵（nerv00kaworu）"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../src/backend/dist/growthmap-sidecar.exe",
          "to": "sidecar/growthmap-sidecar.exe"
        },
        {
          "from": "../src/backend/dist/growthmap-mcp.exe",
          "to": "growthmap-mcp.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "../src/backend/dist/growthmap-sidecar",
          "to": "sidecar/growthmap-sidecar"
        }
      ]
    },
    "linux": {
      "target": [
        "dir"
      ],
      "extraResources": [
        {
          "from": "../src/backend/dist/growthmap-sidecar",
          "to": "sidecar/growthmap-sidecar"
        }
      ]
    }
  },
  "description": "Windows-first local GrowthMap authoring desktop application",
  "author": "GrowthMap Project Contributors",
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
