# Template only; replace domain and configure TLS before enabling.
server { listen 80; server_name growthmap.example.invalid; server_tokens off; location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; } }
