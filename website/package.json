{
  "name": "growthmap-official-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/assemble-standalone.mjs",
    "start": "HOSTNAME=${HOST:-127.0.0.1} PORT=${PORT:-3000} node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "audit:prod": "npm audit --omit=dev",
    "test:routes": "node scripts/check-route-manifest.mjs"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "^16.3.0",
    "typescript": "5.9.3"
  }
}
