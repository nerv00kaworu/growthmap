# Public web-service configuration. Do not put payment, wallet, activation, or recovery secrets here.
# Used only for canonical metadata/sitemap. Omit to keep public indexing safely disabled.
NEXT_PUBLIC_CANONICAL_BASE=https://growthmap.example.invalid

# `npm start` listens using these values. Bind to loopback when behind nginx.
HOST=127.0.0.1
PORT=3000
