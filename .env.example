# Local-only provider secret. Never commit a real key.
LLM_BASE_URL=https://api.openai.com/v1
GROWTHMAP_LLM_KEY_DEFAULT=your-api-key
LLM_MODEL=gpt-4o-mini

# Provider profiles in GrowthMap store only the *name* of this variable
# (for example GROWTHMAP_LLM_KEY_DEFAULT); they never store the secret itself.
